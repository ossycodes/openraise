# Copy to apps/api/.env and adjust. Defaults match docker-compose.yml.

# --- App ---
NODE_ENV=development
PORT=4000
# Public URL of the web app (CORS origin, links in emails)
WEB_URL=http://localhost:3000

# --- Database --- (e2e tests use the same URL with "_e2e" appended to the name)
DATABASE_URL=postgresql://openraise:openraise@localhost:5432/openraise

# --- Auth ---
# At least 32 random characters. Generate one: openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-random-characters
# Access token lifetime in seconds, refresh token lifetime in days
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL_DAYS=30

# --- Email --- (Mailpit catches everything in development: http://localhost:8025)
SMTP_URL=smtp://localhost:1025
MAIL_FROM="OpenRaise <no-reply@openraise.local>"

# --- Storage --- any S3-compatible service; defaults match docker-compose (SeaweedFS)
# Leave STORAGE_ENDPOINT empty for AWS S3; for Cloudflare R2 use
# https://<account-id>.r2.cloudflarestorage.com and STORAGE_REGION=auto
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=openraise
STORAGE_ACCESS_KEY_ID=openraise
STORAGE_SECRET_ACCESS_KEY=openraise-secret
STORAGE_FORCE_PATH_STYLE=true
# Where browsers load files from: the bucket's public URL or a CDN in front of it
STORAGE_PUBLIC_URL=http://localhost:8333/openraise
# Create the bucket at boot if it's missing. Turn off in production.
STORAGE_CREATE_BUCKET=true

# --- Fees --- (published at GET /config/fees)
# Currency campaigns raise in by default: NGN, USD, GHS or KES
DEFAULT_CURRENCY=NGN
# Basis points: 350 = 3.5%. Taken from each donation. Set 0 for a fee-free deployment.
PLATFORM_FEE_BPS=350
# Basis points the donor pays on top to cover payment processing
DONOR_FEE_BPS=150
# Flat donor fee in minor units (10000 = ₦100), only above the threshold (250000 = ₦2,500)
DONOR_FLAT_FEE=10000
DONOR_FLAT_FEE_THRESHOLD=250000
# Flat fee per withdrawal in minor units (5000 = ₦50)
WITHDRAWAL_FEE=5000

# --- Payments --- (disabled until a deployment supplies provider credentials)
PAYMENT_PROVIDER=disabled
# PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
# PAYMENT_PROVIDER=bachs; obtain a separate endpoint signing secret in the portal
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=
# Set https://api.bachs.io with a live key; sandbox is the default.
BACHS_BASE_URL=https://sandbox-api.bachs.io

# --- Payment event processing ---
# Required when payments are enabled. Each deployment/database must use its own prefix.
REDIS_URL=redis://localhost:6379
PAYMENT_QUEUE_PREFIX=openraise
