# Copy to apps/api/.env and adjust. Defaults match docker-compose.yml.

# --- App ---
NODE_ENV=development
PORT=4000
# Public URL of the web app (CORS origin, links in emails)
WEB_URL=http://localhost:3000

# --- Fees --- (published at GET /config/fees)
# Currency campaigns raise in by default: NGN, USD, GHS or KES
DEFAULT_CURRENCY=NGN
# Basis points: 350 = 3.5%. Taken from each donation. Set 0 for a fee-free deployment.
PLATFORM_FEE_BPS=350
# Basis points the donor pays on top to cover payment processing
DONOR_FEE_BPS=150
# Flat donor fee in minor units (10000 = ₦100), only above the threshold (250000 = ₦2,500)
DONOR_FLAT_FEE=10000
DONOR_FLAT_FEE_THRESHOLD=250000
# Flat fee per withdrawal in minor units (5000 = ₦50)
WITHDRAWAL_FEE=5000
