# Copy to apps/web/.env.local. API settings live separately in apps/api/.env.
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# SAME generated >=32-character value as the API; never NEXT_PUBLIC_.
RATE_LIMIT_RELAY_SECRET=
# Production: a SINGLE-IP header which your trusted edge overwrites.
# Block direct access to Next.js so clients cannot bypass that edge.
# Example with nginx: proxy_set_header X-Real-IP $remote_addr;
RATE_LIMIT_CLIENT_IP_HEADER=x-real-ip
