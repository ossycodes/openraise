generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  reportModerationActions ReportModerationAction[]
  campaignReviews         CampaignReview[]
  campaignUpdates         CampaignUpdate[]
  id                      String                   @id @default(cuid())
  /// Always stored lower-cased and trimmed
  email                   String                   @unique
  name                    String
  /// "scrypt$N$r$p$salt$hash" (base64 salt and hash)
  passwordHash            String
  role                    Role                     @default(USER)
  emailVerifiedAt         DateTime?                @db.Timestamptz
  /// Stamped into every access token; bumping it signs out every device
  tokenVersion            Int                      @default(0)
  createdAt               DateTime                 @default(now()) @db.Timestamptz
  updatedAt               DateTime                 @updatedAt @db.Timestamptz
  /// Google's stable account id ("sub"), set on first Google sign-in
  googleSubject           String?                  @unique
  refreshTokens           RefreshToken[]
  emailTokens             EmailToken[]
  donations               Donation[]
  campaigns               Campaign[]
  bankAccounts            BankAccount[]
  withdrawals             Withdrawal[]
  payoutFreezeEvents      PayoutFreezeEvent[]
}

/// Where a user's withdrawals are paid. Removed accounts are kept for history.
model BankAccount {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// ISO country; Nigerian bank accounts only for now
  country            String    @default("NG")
  currency           String    @default("NGN")
  bankCode           String
  bankName           String
  /// 10-digit NUBAN; responses only ever show the last 4 digits
  accountNumber      String
  /// As resolved by the payment provider, never typed by the user
  accountName        String
  /// Which provider holds the payout recipient
  provider           String
  recipientId        String
  /// False when the provider needs the recipient approved before paying it
  recipientUsable    Boolean
  /// Fuzzy match of the resolved name against the user's name (KYC name later)
  nameMatchesProfile Boolean
  isDefault          Boolean   @default(false)
  /// New accounts can't receive withdrawals until this time (24-hour hold)
  payoutsAvailableAt DateTime  @db.Timestamptz
  removedAt          DateTime? @db.Timestamptz
  createdAt          DateTime  @default(now()) @db.Timestamptz

  withdrawals Withdrawal[]

  @@index([userId, removedAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 (hex) of the token; the token itself is never stored
  tokenHash String    @unique
  /// Tokens rotated from one sign-in share a family; reusing a spent token revokes the family
  familyId  String
  expiresAt DateTime  @db.Timestamptz
  /// Set when the token is rotated, signed out, or its family is revoked
  revokedAt DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  @@index([userId])
  @@index([familyId])
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// What a campaign raises for. Seeded by migration; admins can add and edit.
model Category {
  id          String     @id @default(cuid())
  /// URL segment, e.g. "medical"
  slug        String     @unique
  name        String
  description String
  /// Lower comes first in lists
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now()) @db.Timestamptz
  updatedAt   DateTime   @updatedAt @db.Timestamptz
  campaigns   Campaign[]
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  ENDED
  REJECTED
}

model Campaign {
  reports                 CampaignReport[]
  reportModerationActions ReportModerationAction[]
  moderationPaused        Boolean                      @default(false)
  moderationPauseReason   String?
  reviews                 CampaignReview[]
  updates                 CampaignUpdate[]
  updateSubscriptions     CampaignUpdateSubscription[]
  id                      String                       @id @default(cuid())
  /// Public URL segment: slugified title + random suffix, fixed at creation
  slug                    String                       @unique
  ownerId                 String
  owner                   User                         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  categoryId              String
  category                Category                     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title                   String
  /// One or two sentences for cards and link previews
  summary                 String                       @default("")
  videoUrl                String?
  story                   String                       @default("")
  /// Minor units of `currency`
  goalAmount              BigInt
  /// ISO code, one of SUPPORTED_CURRENCIES; fixed once submitted
  currency                String
  beneficiaryName         String?
  location                String?
  endsAt                  DateTime?                    @db.Timestamptz
  status                  CampaignStatus               @default(DRAFT)
  /// Why an admin rejected it; cleared on resubmit
  rejectionReason         String?
  featured                Boolean                      @default(false)
  submittedAt             DateTime?                    @db.Timestamptz
  publishedAt             DateTime?                    @db.Timestamptz
  endedAt                 DateTime?                    @db.Timestamptz
  createdAt               DateTime                     @default(now()) @db.Timestamptz
  updatedAt               DateTime                     @updatedAt @db.Timestamptz
  donations               Donation[]
  images                  CampaignImage[]
  ledgerAccounts          LedgerAccount[]
  withdrawals             Withdrawal[]
  payoutFreezeEvents      PayoutFreezeEvent[]
  payoutsFrozen           Boolean                      @default(false)
  payoutFreezeReason      String?
  /// Generated by Postgres from title, summary, location and story (see the
  /// campaign_search migration); never written by the app. The dbgenerated
  /// text is the expression exactly as Postgres stores it, so Prisma sees no
  /// drift; change both together.
  searchVector            Unsupported("tsvector")?     @default(dbgenerated("((((setweight(to_tsvector('english'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('simple'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\")) || setweight(to_tsvector('english'::regconfig, COALESCE(summary, ''::text)), 'B'::\"char\")) || setweight(to_tsvector('simple'::regconfig, COALESCE(location, ''::text)), 'B'::\"char\")) || setweight(to_tsvector('english'::regconfig, COALESCE(story, ''::text)), 'C'::\"char\"))"))

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([ownerId])
  @@index([searchVector], type: Gin)
}

/// A picture on a campaign. The one at position 0 is the cover.
model CampaignImage {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// Object key in storage: campaigns/{campaignId}/{random}.{ext}
  key         String   @unique
  /// Sniffed from the file's bytes, not taken from the upload
  contentType String
  /// Bytes
  size        Int
  position    Int
  createdAt   DateTime @default(now()) @db.Timestamptz

  @@index([campaignId, position])
}

/// Single-use links sent by email (verify email, reset password)
model EmailToken {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   EmailTokenPurpose
  /// SHA-256 (hex) of the token in the link
  tokenHash String            @unique
  expiresAt DateTime          @db.Timestamptz
  /// Set when the link is used, or when a newer link for the same purpose replaces it
  usedAt    DateTime?         @db.Timestamptz
  createdAt DateTime          @default(now()) @db.Timestamptz

  @@index([userId, purpose])
}

// ---------------------------------------------------------------------------
// Ledger: double-entry bookkeeping. Balances are always sums of entries;
// nothing stores a balance. See docs/Features/Ledger.md.
// ---------------------------------------------------------------------------

enum LedgerAccountType {
  /// Asset: money a payment provider has collected for us and not yet paid out
  PROVIDER_CLEARING
  /// Liability: what we owe a campaign (its wallet)
  CAMPAIGN_WALLET
  /// Liability: withdrawals requested but not yet confirmed by the provider
  PENDING_PAYOUTS
  /// Revenue: platform fees
  PLATFORM_REVENUE
  /// Revenue: processing fees paid by donors (offsets what providers charge us)
  DONOR_FEES
}

model LedgerAccount {
  id         String            @id @default(cuid())
  /// "CAMPAIGN_WALLET:NGN:<campaignId>" or "PLATFORM_REVENUE:NGN"
  key        String            @unique
  type       LedgerAccountType
  /// ISO code; an account holds one currency only
  currency   String
  /// Set for campaign wallets only
  campaignId String?
  campaign   Campaign?         @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  createdAt  DateTime          @default(now()) @db.Timestamptz
  entries    LedgerEntry[]

  @@index([campaignId])
}

enum LedgerTransactionKind {
  DONATION
  WITHDRAWAL_HOLD
  WITHDRAWAL_SETTLE
  WITHDRAWAL_REVERSE
  REFUND
  ADJUSTMENT
}

/// One business event (a donation, a withdrawal step). Never updated or deleted.
model LedgerTransaction {
  donation             Donation?
  withdrawalHold       Withdrawal?           @relation("WithdrawalHold")
  withdrawalSettlement Withdrawal?           @relation("WithdrawalSettlement")
  withdrawalReversal   Withdrawal?           @relation("WithdrawalReversal")
  id                   String                @id @default(cuid())
  kind                 LedgerTransactionKind
  /// One posting per event, e.g. "donation:<id>"; posting it again returns the original
  idempotencyKey       String                @unique
  currency             String
  description          String
  createdAt            DateTime              @default(now()) @db.Timestamptz
  entries              LedgerEntry[]
}

model LedgerEntry {
  id            String            @id @default(cuid())
  transactionId String
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  accountId     String
  account       LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  /// Signed minor units: positive = debit, negative = credit. A transaction's entries sum to zero.
  amount        BigInt
  createdAt     DateTime          @default(now()) @db.Timestamptz

  @@index([accountId])
  @@index([transactionId])
}

enum DonationStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
}

enum CheckoutState {
  INITIALIZING
  READY
  FAILED
  UNCERTAIN
}

model Donation {
  updatesOptIn           Boolean                      @default(false)
  updateSubscriptions    CampaignUpdateSubscription[]
  notifications          DonationNotification[]
  ledgerTransactionId    String?                      @unique
  ledgerTransaction      LedgerTransaction?           @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
  id                     String                       @id @default(cuid())
  campaignId             String
  campaign               Campaign                     @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  donorUserId            String?
  donor                  User?                        @relation(fields: [donorUserId], references: [id], onDelete: SetNull)
  donorName              String?
  donorMessage           String?
  isAnonymous            Boolean                      @default(true)
  donorEmail             String
  idempotencyKeyHash     String                       @unique
  reference              String                       @unique
  provider               String
  providerCheckoutId     String?
  providerPaymentId      String?
  checkoutUrl            String?
  checkoutState          CheckoutState                @default(INITIALIZING)
  status                 DonationStatus               @default(PENDING)
  amount                 BigInt
  currency               String
  platformFee            BigInt
  donorFee               BigInt
  totalCharged           BigInt
  netToCampaign          BigInt
  donorCoversPlatformFee Boolean
  succeededAt            DateTime?                    @db.Timestamptz
  stateEventAt           DateTime?                    @db.Timestamptz
  createdAt              DateTime                     @default(now()) @db.Timestamptz
  updatedAt              DateTime                     @updatedAt @db.Timestamptz

  @@unique([provider, providerCheckoutId])
  @@unique([provider, providerPaymentId])
  @@index([campaignId, status])
  @@index([donorUserId])
}

model PaymentEvent {
  id             String    @id @default(cuid())
  provider       String
  eventId        String
  rawBody        Bytes
  type           String?
  resourceId     String?
  reference      String?
  amount         BigInt?
  currency       String?
  occurredAt     DateTime  @db.Timestamptz
  receivedAt     DateTime  @default(now()) @db.Timestamptz
  processedAt    DateTime? @db.Timestamptz
  outcome        String?
  reason         String?
  lastDispatchAt DateTime? @db.Timestamptz

  @@unique([provider, eventId])
  @@index([processedAt, lastDispatchAt])
}

enum NotificationKind {
  CAMPAIGN_UPDATE
  DONOR_RECEIPT
  CREATOR_DONATIONS
}

enum NotificationState {
  PENDING
  SENDING
  SENT
  UNCERTAIN
  FAILED
}

model NotificationDelivery {
  campaignUpdateId     String?
  campaignUpdate       CampaignUpdate?             @relation(fields: [campaignUpdateId], references: [id], onDelete: Restrict)
  updateSubscriptionId String?
  updateSubscription   CampaignUpdateSubscription? @relation(fields: [updateSubscriptionId], references: [id], onDelete: Restrict)
  id                   String                      @id @default(cuid())
  dedupeKey            String                      @unique
  kind                 NotificationKind
  recipient            String
  campaignTitle        String
  campaignUrl          String
  currency             String
  subject              String?
  text                 String?
  html                 String?
  state                NotificationState           @default(PENDING)
  attempts             Int                         @default(0)
  nextAttemptAt        DateTime                    @default(now()) @db.Timestamptz
  startedAt            DateTime?                   @db.Timestamptz
  sentAt               DateTime?                   @db.Timestamptz
  lastError            String?
  createdAt            DateTime                    @default(now()) @db.Timestamptz
  updatedAt            DateTime                    @updatedAt @db.Timestamptz
  items                DonationNotification[]

  @@index([state, nextAttemptAt])
  @@index([state, startedAt])
}

model DonationNotification {
  id         String               @id @default(cuid())
  donationId String
  donation   Donation             @relation(fields: [donationId], references: [id], onDelete: Restrict)
  kind       NotificationKind
  deliveryId String
  delivery   NotificationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  @@unique([donationId, kind])
  @@index([deliveryId])
}

enum WithdrawalStatus {
  INITIALIZING
  PENDING
  UNCERTAIN
  SUCCEEDED
  FAILED
  REVERSED
}

model Withdrawal {
  id                      String             @id @default(cuid())
  campaignId              String
  campaign                Campaign           @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  userId                  String
  user                    User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  bankAccountId           String
  bankAccount             BankAccount        @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  // Immutable destination and fee snapshots; never returned with recipient identifiers.
  bankName                String
  accountName             String
  accountLast4            String
  recipientId             String
  provider                String
  providerPayoutId        String?
  reference               String             @unique
  idempotencyKeyHash      String             @unique
  currency                String
  amount                  BigInt
  fee                     BigInt
  netPaidOut              BigInt
  status                  WithdrawalStatus   @default(INITIALIZING)
  reconciliationRequired  Boolean            @default(false)
  reason                  String?
  holdTransactionId       String             @unique
  holdTransaction         LedgerTransaction  @relation("WithdrawalHold", fields: [holdTransactionId], references: [id], onDelete: Restrict)
  settlementTransactionId String?            @unique
  settlementTransaction   LedgerTransaction? @relation("WithdrawalSettlement", fields: [settlementTransactionId], references: [id], onDelete: Restrict)
  reversalTransactionId   String?            @unique
  reversalTransaction     LedgerTransaction? @relation("WithdrawalReversal", fields: [reversalTransactionId], references: [id], onDelete: Restrict)
  stateEventAt            DateTime?          @db.Timestamptz
  createdAt               DateTime           @default(now()) @db.Timestamptz
  updatedAt               DateTime           @updatedAt @db.Timestamptz

  @@unique([provider, providerPayoutId])
  @@index([campaignId, createdAt])
  @@index([userId, createdAt])
  @@index([status])
}

model PayoutFreezeEvent {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  frozen     Boolean
  reason     String
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([campaignId, createdAt])
}

model CampaignUpdate {
  id                 String                 @id @default(cuid())
  campaignId         String
  campaign           Campaign               @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  authorId           String
  author             User                   @relation(fields: [authorId], references: [id], onDelete: Restrict)
  title              String
  body               String
  uploadKeys         String[]
  idempotencyKeyHash String                 @unique
  publishedAt        DateTime               @default(now()) @db.Timestamptz
  hiddenAt           DateTime?              @db.Timestamptz
  hiddenById         String?
  fanoutCursor       String?
  fanoutCompletedAt  DateTime?              @db.Timestamptz
  images             CampaignUpdateImage[]
  deliveries         NotificationDelivery[]

  @@index([campaignId, publishedAt])
  @@index([fanoutCompletedAt])
}

model CampaignUpdateImage {
  id          String         @id @default(cuid())
  updateId    String
  update      CampaignUpdate @relation(fields: [updateId], references: [id], onDelete: Restrict)
  key         String         @unique
  contentType String
  size        Int
  position    Int

  @@index([updateId, position])
}

model CampaignUpdateSubscription {
  createdAt      DateTime               @default(now()) @db.Timestamptz
  id             String                 @id @default(cuid())
  campaignId     String
  campaign       Campaign               @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  email          String
  donationId     String
  donation       Donation               @relation(fields: [donationId], references: [id], onDelete: Restrict)
  consentedAt    DateTime               @default(now()) @db.Timestamptz
  unsubscribedAt DateTime?              @db.Timestamptz
  deliveries     NotificationDelivery[]

  @@unique([campaignId, email])
  @@index([campaignId, id])
}

model CampaignReview {
  id              String    @id @default(cuid())
  campaignId      String
  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  reviewerId      String
  reviewer        User      @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  decision        String
  reason          String?
  submittedAt     DateTime? @db.Timestamptz
  reviewedVersion DateTime  @db.Timestamptz
  createdAt       DateTime  @default(now()) @db.Timestamptz

  @@index([campaignId, createdAt])
}

model CampaignReport {
  id                 String                   @id @default(cuid())
  campaignId         String
  campaign           Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  category           String
  details            String
  status             String                   @default("OPEN")
  idempotencyKeyHash String                   @unique
  createdAt          DateTime                 @default(now()) @db.Timestamptz
  updatedAt          DateTime                 @updatedAt @db.Timestamptz
  closedAt           DateTime?                @db.Timestamptz
  actions            ReportModerationAction[]

  @@index([status, createdAt])
  @@index([campaignId])
}

model ReportModerationAction {
  id         String         @id @default(cuid())
  reportId   String
  report     CampaignReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  campaignId String
  campaign   Campaign       @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  actorId    String
  actor      User           @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  reason     String
  createdAt  DateTime       @default(now()) @db.Timestamptz

  @@index([reportId, createdAt])
  @@index([campaignId, createdAt])
}
