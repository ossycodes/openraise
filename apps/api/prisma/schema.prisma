generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id              String         @id @default(cuid())
  /// Always stored lower-cased and trimmed
  email           String         @unique
  name            String
  /// "scrypt$N$r$p$salt$hash" (base64 salt and hash)
  passwordHash    String
  role            Role           @default(USER)
  emailVerifiedAt DateTime?      @db.Timestamptz
  /// Stamped into every access token; bumping it signs out every device
  tokenVersion    Int            @default(0)
  createdAt       DateTime       @default(now()) @db.Timestamptz
  updatedAt       DateTime       @updatedAt @db.Timestamptz
  refreshTokens   RefreshToken[]
  emailTokens     EmailToken[]
  campaigns       Campaign[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 (hex) of the token; the token itself is never stored
  tokenHash String    @unique
  /// Tokens rotated from one sign-in share a family; reusing a spent token revokes the family
  familyId  String
  expiresAt DateTime  @db.Timestamptz
  /// Set when the token is rotated, signed out, or its family is revoked
  revokedAt DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  @@index([userId])
  @@index([familyId])
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// What a campaign raises for. Seeded by migration; admins can add and edit.
model Category {
  id          String   @id @default(cuid())
  /// URL segment, e.g. "medical"
  slug        String   @unique
  name        String
  description String
  /// Lower comes first in lists
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz
  campaigns   Campaign[]
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  ENDED
  REJECTED
}

model Campaign {
  id              String         @id @default(cuid())
  /// Public URL segment: slugified title + random suffix, fixed at creation
  slug            String         @unique
  ownerId         String
  owner           User           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title           String
  /// One or two sentences for cards and link previews
  summary         String         @default("")
  story           String         @default("")
  /// Minor units of `currency`
  goalAmount      BigInt
  /// ISO code, one of SUPPORTED_CURRENCIES; fixed once submitted
  currency        String
  beneficiaryName String?
  location        String?
  endsAt          DateTime?      @db.Timestamptz
  status          CampaignStatus @default(DRAFT)
  /// Why an admin rejected it; cleared on resubmit
  rejectionReason String?
  featured        Boolean        @default(false)
  submittedAt     DateTime?      @db.Timestamptz
  publishedAt     DateTime?      @db.Timestamptz
  endedAt         DateTime?      @db.Timestamptz
  createdAt       DateTime       @default(now()) @db.Timestamptz
  updatedAt       DateTime       @updatedAt @db.Timestamptz

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([ownerId])
}

/// Single-use links sent by email (verify email, reset password)
model EmailToken {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   EmailTokenPurpose
  /// SHA-256 (hex) of the token in the link
  tokenHash String            @unique
  expiresAt DateTime          @db.Timestamptz
  /// Set when the link is used, or when a newer link for the same purpose replaces it
  usedAt    DateTime?         @db.Timestamptz
  createdAt DateTime          @default(now()) @db.Timestamptz

  @@index([userId, purpose])
}
